library(readr)
install.packages("lavaan")
install.packages("lavaan")
library(lavaan)
library(dplyr)
#load data
T1subset <- read_csv("data/02scalesT1.csv")
Attachmentvars #check variables
all(Attachmentvars %in% names(T1subset))
AttachmentModel <- 'Attachment =~
momcomm_t1 + momtrust_t1 + momalien_t1R + momattach_t1 +
fathercomm_t1 + fathertrust_t1 + fatheralien_t1R + fatherattach_t1 +
peercomm_t1 + peertrust_t1 + peeralien_t1R + peerattach_t1 +
disclosure_t1 + parentsolicit_t1 + parentknow_t1 +
parentcontrol_t1R + parentmonitor_t1'
AttachmentModel
#fit cfa attachment model
AttachmentT1fit <- cfa(model = AttachmentModel,
data = T1subset,
std.lv = TRUE) #FOR LATENT VARIANCE
#check missing  variables
AttachmentvarsT1 <- c("momcomm_t1", "momtrust_t1", "momalien_t1R",
"fathercomm_t1", "fathertrust_t1", "fatheralien_t1R",
"peercomm_t1", "peertrust_t1", "peeralien_t1R",
"disclosure_t1", "parentsolicit_t1", "parentknow_t1",
"parentcontrol_t1R", "parentmonitor_t1")
#composite scores need to be removed from model
AttachmentModelT1 <- 'Attachment =~
momcomm_t1 + momtrust_t1 + momalien_t1R +
fathercomm_t1 + fathertrust_t1 + fatheralien_t1R +
peercomm_t1 + peertrust_t1 + peeralien_t1R +
disclosure_t1 + parentsolicit_t1 + parentknow_t1 +
parentcontrol_t1R + parentmonitor_t1'
