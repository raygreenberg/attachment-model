#attachment-model-rscript
R script analysis for functional attachment modeling and risk-associated decision
#contents
- **Data connection**: Scripts assume `/data/02scalesT1.csv` as the primary cleaned T1 dataset.
#workflow
01. **Load/clean data**
#dependencies
- `readr`
#define refined attachment indicators (based on attempt 1: keep (re-add) control/solicitation, drop peer indicators)
AttachmentvarsT1 <- c("momcomm_t1", "momtrust_t1", "momalien_t1R",
"fathercomm_t1", "fathertrust_t1", "fatheralien_t1R",
"parentsolicit_t1", "parentcontrol_t1R")
#check variables in the dataset
AttachmentvarsT1[!AttachmentvarsT1 %in% names(T1subset)]
#define refined attachment indicators (based on attempt 1: keep (re-add) control/solicitation, drop peer indicators)
